{
  "name": "desk-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 桌面陪伴宠物",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "koffi": "3.3.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "electron-winstaller": false,
    "koffi@3.3.7": false
  }
}
